<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_live" />

    <TextView
        android:id="@+id/live_stats"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:id="@+id/live_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:padding="22dp">

        <ImageView
            android:id="@+id/live_logo"
            android:layout_width="160dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_logo"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_caption"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textColor="@color/accent_light"
                android:textSize="@dimen/text_tiny" />

            <TextView
                android:id="@+id/live_title"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/live_body"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary" />

            <ProgressBar
                android:id="@+id/live_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_epg"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/live_primary"
                    style="@style/NovaButton"
                    android:layout_width="wrap_content"
                    android:drawableStart="@drawable/ic_play" />

                <TextView
                    android:id="@+id/live_secondary"
                    style="@style/NovaButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="14dp"
                    android:drawableStart="@drawable/ic_list" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/live_recent_title"
        style="@style/Text.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/nav_recent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/live_recent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
            android:defaultFocusHighlightEnabled="false" />

    <TextView
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/live_remote_help"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_tiny" />
</LinearLayout>
