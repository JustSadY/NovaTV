<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
        android:focusable="false"
        android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="@dimen/safe_v"
        android:paddingEnd="96dp"
        android:paddingBottom="@dimen/safe_v">

        <TextView
            android:id="@+id/se_title"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/source_name" />

        <EditText
            android:id="@+id/se_name"
            style="@style/NovaInput"
            android:layout_width="match_parent"
            android:hint="@string/source_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/source_type" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/se_type_url"
                style="@style/NovaButton"
                android:layout_width="wrap_content"
                android:drawableStart="@drawable/ic_link"
                android:text="@string/source_type_url" />

            <TextView
                android:id="@+id/se_type_file"
                style="@style/NovaButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_file"
                android:text="@string/source_type_file" />

            <TextView
                android:id="@+id/se_type_phone"
                style="@style/NovaButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_phone"
                android:text="@string/link_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/se_url_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_url" />

            <EditText
                android:id="@+id/se_url"
                style="@style/NovaInput"
                android:layout_width="match_parent"
                android:hint="@string/source_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/se_file_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_file" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/se_pick"
                    style="@style/NovaButton"
                    android:layout_width="wrap_content"
                    android:drawableStart="@drawable/ic_folder"
                    android:text="@string/source_pick_file" />

                <TextView
                    android:id="@+id/se_file_path"
                    style="@style/Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="@string/source_file_none" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/source_epg" />

        <EditText
            android:id="@+id/se_epg"
            style="@style/NovaInput"
            android:layout_width="match_parent"
            android:hint="@string/source_epg_hint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/source_ua" />

        <EditText
            android:id="@+id/se_ua"
            style="@style/NovaInput"
            android:layout_width="match_parent"
            android:hint="@string/source_ua_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/se_save"
                style="@style/NovaButton"
                android:layout_width="wrap_content"
                android:drawableStart="@drawable/ic_refresh"
                android:text="@string/source_save_load" />

            <TextView
                android:id="@+id/se_cancel"
                style="@style/NovaButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/cancel" />

            <TextView
                android:id="@+id/se_delete"
                style="@style/NovaButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_delete"
                android:text="@string/delete"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/se_progress"
                style="@android:style/Widget.Material.ProgressBar.Small"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="18dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/se_status"
                style="@style/Text.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/source_legal"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_tiny" />
    </LinearLayout>
</ScrollView>
