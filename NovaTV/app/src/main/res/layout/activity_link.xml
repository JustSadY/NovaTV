<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="72dp"
        android:paddingTop="@dimen/safe_v"
        android:paddingEnd="@dimen/safe_h"
        android:paddingBottom="@dimen/safe_v">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="290dp"
                android:layout_height="290dp"
                android:background="@drawable/bg_qr">

                <ImageView
                    android:id="@+id/link_qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/link_scan_hint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="44dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/link_title" />

            <TextView
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/link_steps"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/link_address" />

            <TextView
                android:id="@+id/link_address"
                style="@style/Text.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_light" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/link_pin" />

            <TextView
                android:id="@+id/link_pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_number"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.3"
                android:paddingStart="22dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text_primary"
                android:textSize="40sp" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/link_received" />

            <TextView
                android:id="@+id/link_log"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:text="@string/link_waiting"
                android:textColor="@color/text_secondary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/link_hint"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/link_hint_screen"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_tiny" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/link_error"
        style="@style/Text"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/osd"
        style="@style/Osd" />
</FrameLayout>
