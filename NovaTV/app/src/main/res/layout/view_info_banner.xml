<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_banner_scrim"
    android:paddingStart="@dimen/safe_h"
    android:paddingTop="70dp"
    android:paddingEnd="@dimen/safe_h"
    android:paddingBottom="@dimen/safe_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ib_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:minWidth="76dp"
            android:textColor="@color/accent_light"
            android:textSize="40sp" />

        <ImageView
            android:id="@+id/ib_logo"
            android:layout_width="132dp"
            android:layout_height="82dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_logo"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ib_name"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="520dp"
                    android:singleLine="true"
                    android:textSize="30sp" />

                <ImageView
                    android:id="@+id/ib_fav"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star_filled"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ib_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ib_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_accent"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/text_on_accent"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/ib_group"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true" />

            <TextView
                android:id="@+id/ib_now"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:singleLine="true" />

            <ProgressBar
                android:id="@+id/ib_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_epg" />

            <TextView
                android:id="@+id/ib_next"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/ib_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="24dp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text_primary"
            android:textSize="34sp" />
    </LinearLayout>
</FrameLayout>
