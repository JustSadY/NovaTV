<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_sources" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/src_add"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:drawableStart="@drawable/ic_add"
            android:text="@string/sources_add" />

        <TextView
            android:id="@+id/src_phone"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="14dp"
            android:drawableStart="@drawable/ic_phone"
            android:text="@string/link_button" />

        <TextView
            android:id="@+id/src_refresh_all"
            style="@style/NovaButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="14dp"
            android:drawableStart="@drawable/ic_refresh"
            android:text="@string/sources_refresh_all" />

        <ProgressBar
            android:id="@+id/src_progress"
            style="@android:style/Widget.Material.ProgressBar.Small"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="18dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/src_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:defaultFocusHighlightEnabled="false" />

        <TextView
            android:id="@+id/src_empty"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/sources_empty"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/source_legal"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_tiny" />
</LinearLayout>
