<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <com.novatv.player.ui.common.SidebarLayout
            android:id="@+id/sidebar"
            android:layout_width="@dimen/sidebar_width"
            android:layout_height="match_parent"
            android:background="@color/bg_sidebar"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="@dimen/safe_v"
            android:paddingEnd="16dp"
            android:paddingBottom="@dimen/safe_v">

            <TextView
                android:id="@+id/brand"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/clock"
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/nav_live"
                style="@style/NavItem"
                android:drawableStart="@drawable/ic_live"
                android:text="@string/nav_live" />

            <TextView
                android:id="@+id/nav_all"
                style="@style/NavItem"
                android:drawableStart="@drawable/ic_list"
                android:text="@string/nav_all" />

            <TextView
                android:id="@+id/nav_categories"
                style="@style/NavItem"
                android:drawableStart="@drawable/ic_category"
                android:text="@string/nav_categories" />

            <TextView
                android:id="@+id/nav_favorites"
                style="@style/NavItem"
                android:drawableStart="@drawable/ic_star"
                android:text="@string/nav_favorites" />

            <TextView
                android:id="@+id/nav_recent"
                style="@style/NavItem"
                android:drawableStart="@drawable/ic_history"
                android:text="@string/nav_recent" />

            <TextView
                android:id="@+id/nav_sources"
                style="@style/NavItem"
                android:drawableStart="@drawable/ic_source"
                android:text="@string/nav_sources" />

            <TextView
                android:id="@+id/nav_settings"
                style="@style/NavItem"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/nav_settings" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sidebar_footer"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_tiny" />
        </com.novatv.player.ui.common.SidebarLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="32dp"
            android:paddingTop="@dimen/safe_v"
            android:paddingEnd="@dimen/safe_h"
            android:paddingBottom="@dimen/safe_v" />
    </LinearLayout>

    <TextView
        android:id="@+id/osd"
        style="@style/Osd" />
</FrameLayout>
