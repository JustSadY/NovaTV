<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/panel_width"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel_left"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="@dimen/safe_v"
    android:paddingEnd="16dp"
    android:paddingBottom="@dimen/safe_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/panel_group"
            style="@style/Text.Large"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <TextView
        android:id="@+id/panel_count"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textSize="@dimen/text_tiny" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/panel_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
        android:scrollbars="vertical"
            android:defaultFocusHighlightEnabled="false" />

    <TextView
        android:id="@+id/panel_empty"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/empty_channels"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/panel_epg_now"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/panel_epg_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/progress_epg"
        android:visibility="gone" />

    <TextView
        android:id="@+id/panel_epg_next"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true" />

    <TextView
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/panel_hint"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_tiny" />
</LinearLayout>
